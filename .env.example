# Copy to .env and fill in real values locally. Never commit .env.
# List every variable your app needs, with placeholder values only.

# Groq API key for summaries (console.groq.com). Optional: without it the paper still generates, showing source headlines with links.
GROQ_API_KEY=your-key-here

# Where stories come from: live (fetch feeds now), snapshot (newest saved snapshot) or fixtures (bundled test feeds).
SUBAH_SOURCE=live

# AI quota controls: stories per call, and the most calls one paper may make.
SUBAH_AI_BATCH=5
SUBAH_MAX_AI_CALLS=3

# Model for summaries.
SUBAH_MODEL=openai/gpt-oss-120b

# Set to off to force the no-AI path (for testing the fallback).
SUBAH_AI=on
