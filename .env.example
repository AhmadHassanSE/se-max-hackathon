# Copy to .env and fill in real values locally. Never commit .env.
# List every variable your app needs, with placeholder values only.

# Groq API key for summaries (console.groq.com). Optional: without it the paper still generates, showing source headlines with links.
GROQ_API_KEY=your-key-here

# Where stories come from: live (fetch feeds now), snapshot (newest saved snapshot) or fixtures (bundled test feeds).
SUBAH_SOURCE=live

# AI quota controls: stories per call, and the most calls one paper may make.
SUBAH_AI_BATCH=5
SUBAH_MAX_AI_CALLS=3

# Model for summaries.
SUBAH_MODEL=openai/gpt-oss-120b

# Set to off to force the no-AI path (for testing the fallback).
SUBAH_AI=on

# Accounts. Without MONGODB_URI, accounts are kept in memory and forgotten on restart.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
SUBAH_DB=subah

# Gift papers by email through Gmail: the address, and a 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords), never the account password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Link used in gift emails.
SUBAH_SITE_URL=https://ranaahmad3048-subah.hf.space
